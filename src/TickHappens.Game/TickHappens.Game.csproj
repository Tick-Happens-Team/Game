<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TickHappensEosSdk)' != ''">
    <DefineConstants>$(DefineConstants);TICKHAPPENS_EOS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TickHappensEosSdk)' != ''">
    <ProjectReference Include="../TickHappens.EosSdk/TickHappens.EosSdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TickHappens.Engine\TickHappens.Engine.csproj" />
    <ProjectReference Include="../TickHappens.Localization/TickHappens.Localization.csproj" />
    <None Include="..\..\assets\**\*" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Online/LICENSE-LiteNetLib.txt" TargetPath="LICENSE-LiteNetLib.txt" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>
</Project>

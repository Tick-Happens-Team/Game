  "general": [
    {
      "text": "Fixed character rubber-banding in co-op: the host applies every input exactly once, and packet loss no longer eats a dash",
      "change": "fix",
      "details": [
        "Slows and roots end on the same tick for the host and the player",
        "Other players and enemies move smoothly even when snapshots arrive late"
      ]
    },
    {
      "text": "Co-op rooms show the right ping: everyone sees their own round trip to the host",
      "change": "fix"
    },
    {
      "text": "The launcher has a version history: the Patch notes page opens the changes of any earlier release",
      "change": "new"
    },
    {
      "text": "Co-op only works between players on the same version: update before playing together"
    }
